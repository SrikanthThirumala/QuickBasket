provider "aws" {
  region = "us-west-2"
  profile = "tempcloud"
}

resource "aws_vpc" "sri_netf_vpc" {
  cidr_block = "10.0.0.0/16"
  tags = {
    Name="sri_netf_vpc"
  }
}

resource "aws_internet_gateway" "sri_netf_igw" {
  vpc_id = aws_vpc.sri_netf_vpc.id
  
  tags = {
    Name="sri_netf_igw"
  }
}

resource "aws_subnet" "sri_netf_public_1" {
  vpc_id = aws_vpc.sri_netf_vpc.id
  availability_zone = "us-west-2a"
  cidr_block = "10.0.1.0/24"
  tags = {
        Name="Sri_netf_public_1"
  }
}

resource "aws_subnet" "sri_netf_public_2" {
  vpc_id = aws_vpc.sri_netf_vpc.id
  availability_zone = "us-west-2b"
  cidr_block = "10.0.2.0/24"
  tags = {
        Name="Sri_netf_public_2"
  }
}

resource "aws_route_table" "sri_netf_public_RTB" {
  vpc_id = aws_vpc.sri_netf_vpc.id
  route {
    cidr_block = "0.0.0.0/0"
    gateway_id = aws_internet_gateway.sri_netf_igw.id
  }
  tags = {
    Name="sri_netf_public_RTB"
  }
}

resource "aws_route_table_association" "sri_netf_public_RTB_Assoc_1" {
    route_table_id = aws_route_table.sri_netf_public_RTB.id
  subnet_id = aws_subnet.sri_netf_public_1.id
}

resource "aws_route_table_association" "sri_netf_public_RTB_Assoc_2" {
    route_table_id = aws_route_table.sri_netf_public_RTB.id
  subnet_id = aws_subnet.sri_netf_public_2.id
}

resource "aws_subnet" "sri_netf_private_1" {
  vpc_id = aws_vpc.sri_netf_vpc.id
  availability_zone = "us-west-2a"
  cidr_block = "10.0.3.0/24"
  tags = {
    Name="sri_netf_private_1"
  }
}


resource "aws_subnet" "sri_netf_private_2" {
  vpc_id = aws_vpc.sri_netf_vpc.id
  availability_zone = "us-west-2b"
  cidr_block = "10.0.4.0/24"
  tags = {
    Name="sri_netf_private_2"
  }
}

resource "aws_nat_gateway" "sri_netf_ngw" {
  vpc_id = aws_vpc.sri_netf_vpc.id
  availability_mode = "regional"
  tags = {
    Name="sri_netf_ngw"
  }
}

resource "aws_route_table" "sri_netf_private_RTB" {
  vpc_id = aws_vpc.sri_netf_vpc.id
  route {
    cidr_block = "0.0.0.0/0"
    gateway_id = aws_nat_gateway.sri_netf_ngw.id
  }
  tags = {
    Name="sri_netf_private_RTB"
  }
}

resource "aws_route_table_association" "sri_netf_private_RTB_Assoc_1" {
  route_table_id = aws_route_table.sri_netf_private_RTB.id
  subnet_id = aws_subnet.sri_netf_private_1.id
}


resource "aws_route_table_association" "sri_netf_private_RTB_Assoc_2" {
  route_table_id = aws_route_table.sri_netf_private_RTB.id
  subnet_id = aws_subnet.sri_netf_private_2.id
}

resource "aws_subnet" "DB-1-sri_netf_private_1" {
  vpc_id = aws_vpc.sri_netf_vpc.id
  availability_zone = "us-west-2a"
  cidr_block = "10.0.5.0/24"
  tags = {
    Name="DB-1-sri_netf_private_1"
  }
}


resource "aws_subnet" "DB-2-sri_netf_private_2" {
  vpc_id = aws_vpc.sri_netf_vpc.id
  availability_zone = "us-west-2b"
  cidr_block = "10.0.6.0/24"
  tags = {
    Name="DB-2-sri_netf_private_1"
  }
}

resource "aws_security_group" "sri_netf_EC2_SG" {
  vpc_id = aws_vpc.sri_netf_vpc.id
  name = "sri_netf_EC2_SG"
  ingress  {
    cidr_blocks = ["0.0.0.0/0"]
    from_port = "0"
    to_port = "0"
    protocol = "-1"
    description = "Allow"
  }

  egress {
    cidr_blocks = [ "0.0.0.0/0" ]
    from_port = "0"
    to_port = "0"
    protocol = "-1"
    description = "allow all outbound traffic"
  }
}

resource "aws_security_group" "sri_netf_RDS_SG" {
  name = "sri_netf_RDS_SG"
  vpc_id = aws_vpc.sri_netf_vpc.id
  ingress {
    cidr_blocks = [ "0.0.0.0/0" ]
    from_port = "0"
    to_port  ="0"
    protocol = "-1"
    description = "allow"

  }
  egress {
    cidr_blocks = [ "0.0.0.0/0" ]
    from_port = "0"
    to_port  ="0"
    protocol = "-1"
    description = "allow all outbound traffic"
    
  }
}

resource "aws_security_group" "sri_netf_ALB_SG" {
  name = "sri_netf_ALB_SG"
  vpc_id = aws_vpc.sri_netf_vpc.id
  ingress {
    cidr_blocks = [ "0.0.0.0/0" ]
    from_port = "0"
    to_port  ="0"
    protocol = "-1"
    description = "allow"

  }
  egress {
    cidr_blocks = [ "0.0.0.0/0" ]
    from_port = "0"
    to_port  ="0"
    protocol = "-1"
    description = "allow all outbound traffic"
    
  }
}


resource "aws_instance" "sri_netf_front_end_server" {
  instance_type = var.sri_netf_type_value
  ami = var.sri_netf_ami_value
  availability_zone = "us-west-2a"
  subnet_id = aws_subnet.sri_netf_private_1.id
  private_ip = "10.0.3.100"
  vpc_security_group_ids = [ aws_security_group.sri_netf_EC2_SG.id ]
  iam_instance_profile = "sri-custom-role"
  user_data_base64 = filebase64("frontend_userdata.sh")
  depends_on = [ aws_route_table_association.sri_netf_private_RTB_Assoc_1 ]
  tags = {
    Name="sri_netf_front_end_server"
  }
}


resource "aws_instance" "sri_netf_back_end_server" {
  instance_type = var.sri_netf_type_value
  ami = var.sri_netf_ami_value
  availability_zone = "us-west-2a"
  subnet_id = aws_subnet.sri_netf_private_1.id
  private_ip = "10.0.3.99"
  security_groups = [ aws_security_group.sri_netf_EC2_SG.id ]
  iam_instance_profile = "sri-custom-role"
  user_data_base64= filebase64("backend_userdata.sh")
  depends_on = [ aws_route_table_association.sri_netf_private_RTB_Assoc_1]
  tags = {
    Name="sri_netf_back_end_server"
  }
}

resource "aws_lb" "sri_netf_Frontend-ALB" {
  name = "sri-netf-Frontend-ALB"
  subnets = [ aws_subnet.sri_netf_public_1.id,aws_subnet.sri_netf_public_2.id ]
  load_balancer_type = "application"
  security_groups = [ aws_security_group.sri_netf_ALB_SG.id ]
  depends_on = [ aws_instance.sri_netf_front_end_server ]

}

resource "aws_lb_target_group" "sri_netf_Frontend-TG-1" {
  depends_on = [ aws_lb.sri_netf_Frontend-ALB ]
  name = "sri-netf-Frontend-TG-1"
  vpc_id = aws_vpc.sri_netf_vpc.id
  port = "80"
  protocol = "HTTP"
  health_check {
    port = "traffic-port"
    path = "/"
  }
}

resource "aws_lb_target_group_attachment" "sri_netf_Frontend-TG-Attch-1" {
  target_group_arn = aws_lb_target_group.sri_netf_Frontend-TG-1.arn
  port = "80"
  target_id = aws_instance.sri_netf_front_end_server.id
  
}

resource "aws_lb_listener" "sri-netf-Frontend-ALB-listener" {
  load_balancer_arn = aws_lb.sri_netf_Frontend-ALB.arn
  port = "80"
  protocol = "HTTP"
  default_action {
    target_group_arn = aws_lb_target_group.sri_netf_Frontend-TG-1.arn
    type = "forward"
  }
}

resource "aws_lb" "sri_netf_Backend-ALB" {
  name = "sri-netf-Backend-ALB"
  subnets = [aws_subnet.sri_netf_public_1.id,aws_subnet.sri_netf_public_2.id ]
  security_groups = [ aws_security_group.sri_netf_ALB_SG.id ]
  load_balancer_type = "application"
  depends_on = [ aws_instance.sri_netf_back_end_server ]
}

resource "aws_lb_target_group" "sri_netf_Backend-TG-1" {
  depends_on = [ aws_lb.sri_netf_Backend-ALB ]
  port = "8000"
  vpc_id = aws_vpc.sri_netf_vpc.id
  name = "sri-netf-Backend-TG-1"
  protocol = "HTTP"
  health_check {
    port = "traffic-port"
    path = "/"
  }

  
}

resource "aws_lb_target_group_attachment" "sri_netf_Backend-TG-Attch-2" {
  target_group_arn = aws_lb_target_group.sri_netf_Backend-TG-1.arn
  target_id = aws_instance.sri_netf_back_end_server.id
  port = "8000"
}

resource "aws_lb_listener" "sri_netf_Backend-ALB_listener" {
  load_balancer_arn = aws_lb.sri_netf_Backend-ALB.arn
  port = "80"
  protocol = "HTTP"
  default_action {
        target_group_arn = aws_lb_target_group.sri_netf_Backend-TG-1.arn
            type = "forward"
  }
  }































