# Local .terraform directories
**/.terraform/*

# .tfstate files (Contains sensitive infrastructure data!)
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which are likely to contain sensitive data
# *.tfvars
#  *.tfvars.json

# Ignore override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json


.env

